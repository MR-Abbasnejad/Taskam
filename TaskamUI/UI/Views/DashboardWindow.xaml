<Window x:Class="TaskamUI.UI.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:calendar="clr-namespace:TaskamUI.UI.Views.Calendar"
        xmlns:tasks="clr-namespace:TaskamUI.UI.Views.Tasks"
        xmlns:timeline="clr-namespace:TaskamUI.UI.Views.Timeline"
        Title="Taskam"
        Width="1400"
        Height="800"
        Background="#181818"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Navbar Bar -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#202020"
                Padding="10">

            <Button Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    >

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Logo - Using Pack URI -->
                    <Image Source="taskam_logo.png"
                           Width="30"
                           Height="30"
                                           Margin="0,0,10,0"/>

                    <!-- App Name -->
                    <TextBlock Text="Taskam"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Border>

        <!-- Calendar Card -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="10"
                Padding="10"
                Background="#2C2C2C"
                CornerRadius="8">
            <calendar:CalendarView/>
        </Border>

        <!-- Tasks Card -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                Padding="10"
                Background="#2C2C2C"
                CornerRadius="8">
            <tasks:TasksView/>
        </Border>

        <!-- Timeline Card -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="10"
                Padding="10"
                Background="#2C2C2C"
                CornerRadius="8">
            <timeline:TimelineView/>
        </Border>

    </Grid>
</Window>