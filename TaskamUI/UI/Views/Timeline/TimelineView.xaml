<UserControl x:Class="TaskamUI.UI.Views.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TaskamUI.UI.ViewModels"
             xmlns:converters="clr-namespace:TaskamUI.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1400"
             Background="#1E1E1E">

    <UserControl.DataContext>
        <vm:TimelineViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ROW HEIGHT -->
        <converters:RowHeightConverter x:Key="RowHeightConverter"/>

        <!-- PROJECT CONTEXT MENU -->
        <ContextMenu x:Key="ProjectContextMenu">
            <MenuItem Header="Delete Project"
                      Foreground="White"
                      Background="#C62828"
                      Click="DeleteProjectMenuItem_Click"/>
        </ContextMenu>

        <!-- PROJECT LABEL -->
        <Style x:Key="TimelineProjectLabel" TargetType="Button">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="12,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DATE HEADER -->
        <Style x:Key="TimelineDateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- TIMELINE BAR -->
        <Style x:Key="TimelineBarStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>

                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="0"
                                              Color="#66000000"
                                              Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>

                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT HEADER -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="0 0 1 1"
                Padding="14 0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Projects"
                           Foreground="#EAEAEA"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Width="34"
                        Height="34"
                        Content="+"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#1E88E5"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="10 0 0 0"
                        Click="AddProjectClick"/>

            </Grid>

        </Border>

        <!-- RIGHT HEADER -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="0 0 0 1">

            <DockPanel LastChildFill="False"
                       Margin="12 0">

                <TextBlock Text="Timeline"
                           Foreground="#EAEAEA"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <Button Content="Today"
                        DockPanel.Dock="Right"
                        Background="#2A2A2A"
                        Foreground="#EAEAEA"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        Padding="10 4"
                        Cursor="Hand"
                        FontSize="12"
                        Click="TodayButton_Click"/>

            </DockPanel>

        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      Grid.ColumnSpan="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1E1E1E">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PROJECT LIST -->
                <!-- LEFT PROJECT LIST -->
                <Border Grid.Column="0"
        Background="#1E1E1E"
        BorderBrush="#333333"
        BorderThickness="0 0 1 0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <!-- TOP EMPTY SPACE -->
                            <RowDefinition Height="40"/>

                            <!-- PROJECTS -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- EMPTY HEADER SPACE -->
                        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="0 0 0 0"/>

                        <!-- PROJECT ITEMS -->
                        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Projects}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Button Content="{Binding Title}"
                            Height="50"
                            Style="{StaticResource TimelineProjectLabel}"
                            Tag="{Binding}"
                            ContextMenu="{StaticResource ProjectContextMenu}"
                            Click="ProjectName_Click"/>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Grid>

                </Border>


                <!-- RIGHT TIMELINE -->
                <Grid Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DATE HEADER -->
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding Dates}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Width="80"
                                        Height="40"
                                        BorderBrush="#333333"
                                        BorderThickness="0 0 1 1">

                                    <TextBlock Text="{Binding StringFormat={}{0:dd MMM}}"
                                               Style="{StaticResource TimelineDateText}"/>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <!-- TIMELINE BODY -->
                    <Grid Grid.Row="1">

                        <!-- ROW BACKGROUNDS -->
                        <ItemsControl ItemsSource="{Binding Projects}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Height="50"
                                            BorderBrush="#2C2C2C"
                                            BorderThickness="0 0 0 1"
                                            Width="{Binding DataContext.TimelineWidth,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- BARS -->
                        <Canvas x:Name="BarsCanvas"
                                Background="Transparent"
                                Width="{Binding TimelineWidth}"
                                Height="{Binding Projects.Count,
                                                 Converter={StaticResource RowHeightConverter}}">

                            <!-- TODAY LINE -->
                            <Line Stroke="#FF5555"
                                  StrokeThickness="2"
                                  Y1="0"
                                  Y2="{Binding ActualHeight,
                                               RelativeSource={RelativeSource AncestorType=Canvas}}"
                                  X1="{Binding TodayX}"
                                  X2="{Binding TodayX}"/>

                        </Canvas>

                    </Grid>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>
