<UserControl x:Class="TaskamUI.UI.Views.Calendar.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#121212">

    <Grid Background="#121212">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TOP LEFT -->
        <Border Grid.Row="0"
                Grid.Column="0"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,1,1"
                Background="#121212"/>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Grid.Column="1"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,0,1"
                Background="#121212">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Saturday"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Sunday"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="Monday"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="Tuesday"
                           Foreground="#EAEAEA"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Text="Wednesday"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="5"
                           Text="Thursday"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6"
                           Text="Friday"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="7"
                        Width="36"
                        Height="36"
                        Content="+"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#1E88E5"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="AddEvent_Click"/>
            </Grid>
        </Border>

        <!-- TIME LABELS -->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      x:Name="TimeScrollViewer"
                      ScrollChanged="TimeScrollViewer_ScrollChanged">

            <ItemsControl x:Name="TimeLabelsControl"
                          Height="1440">
                <ItemsControl.Items>
                    <sys:Int32>0</sys:Int32>
                    <sys:Int32>1</sys:Int32>
                    <sys:Int32>2</sys:Int32>
                    <sys:Int32>3</sys:Int32>
                    <sys:Int32>4</sys:Int32>
                    <sys:Int32>5</sys:Int32>
                    <sys:Int32>6</sys:Int32>
                    <sys:Int32>7</sys:Int32>
                    <sys:Int32>8</sys:Int32>
                    <sys:Int32>9</sys:Int32>
                    <sys:Int32>10</sys:Int32>
                    <sys:Int32>11</sys:Int32>
                    <sys:Int32>12</sys:Int32>
                    <sys:Int32>13</sys:Int32>
                    <sys:Int32>14</sys:Int32>
                    <sys:Int32>15</sys:Int32>
                    <sys:Int32>16</sys:Int32>
                    <sys:Int32>17</sys:Int32>
                    <sys:Int32>18</sys:Int32>
                    <sys:Int32>19</sys:Int32>
                    <sys:Int32>20</sys:Int32>
                    <sys:Int32>21</sys:Int32>
                    <sys:Int32>22</sys:Int32>
                    <sys:Int32>23</sys:Int32>
                </ItemsControl.Items>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="60"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,1,1"
                                Background="#121212">
                            <TextBlock Text="{Binding StringFormat={}{0:00}:00}"
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,4,8,0"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- CALENDAR BODY -->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      x:Name="MainScrollViewer"
                      ScrollChanged="MainScrollViewer_ScrollChanged">

            <Grid x:Name="CalendarBody"
                  Height="1440">

                <ItemsControl x:Name="CalendarGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="24"
                                         Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="60"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="0,0,1,1"
                                    Background="#121212"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Canvas x:Name="EventCanvas"
                        Background="Transparent"
                        Panel.ZIndex="10"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>