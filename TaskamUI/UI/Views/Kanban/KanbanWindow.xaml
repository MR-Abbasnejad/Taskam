<Window x:Class="TaskamUI.UI.Views.Kanban.KanbanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TaskamUI.UI.ViewModels"
        mc:Ignorable="d"
        Title="KanbanBoard" Height="600" Width="1000"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">



    <Window.Resources>
        <!-- Modern card style for backlog items -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Column header style -->
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Button style for add/delete -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E88E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

        <!-- Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Todo Column -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="📋 Todo" Style="{StaticResource ColumnHeaderStyle}"/>
                    <ItemsControl ItemsSource="{Binding TodoItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="→ In Progress" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                            <Button Content="🗑 Delete" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.DeleteBacklogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add new item -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBox x:Name="NewTodoTitle" Text="{Binding NewBacklogTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#3A3A3D" Foreground="White" BorderThickness="0" Padding="8"
                                 FontSize="13" Margin="0,0,0,6"/>
                        <Button Content="+ Add Task" Style="{StaticResource ActionButton}"
                                Command="{Binding AddBacklogCommand}" Background="#1E88E5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- In Progress Column -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="🚀 In Progress" Style="{StaticResource ColumnHeaderStyle}"/>
                    <ItemsControl ItemsSource="{Binding InProgressItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="← Todo" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.MoveBackToTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                            <Button Content="Done →" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.MoveToDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                            <Button Content="🗑 Delete" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.DeleteBacklogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Done Column -->
            <Border Grid.Column="4" Background="#252526" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="✅ Done" Style="{StaticResource ColumnHeaderStyle}"/>
                    <ItemsControl ItemsSource="{Binding DoneItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" TextWrapping="Wrap" Opacity="0.7"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="← In Progress" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.MoveToInProgressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                            <Button Content="🗑 Delete" Style="{StaticResource ActionButton}"
                                                    Command="{Binding DataContext.DeleteBacklogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>