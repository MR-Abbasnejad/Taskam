<UserControl x:Class="TaskamUI.UI.Views.Tasks.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Blue Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4C6EF5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="34"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btn"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#3B5BDB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btn" Property="Background" Value="#364FC7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task Card Template - FIXED CHECKBOX -->
        <DataTemplate x:Key="TaskTemplate">
            <Border Background="#3B3B3B"
                    CornerRadius="8"
                    Padding="10"
                    Margin="4"
                    BorderBrush="#4A4A4A"
                    BorderThickness="1">

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <!-- Complete Checkbox - REMOVED Command binding -->
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                              Checked="CheckBox_Toggled"
                              Unchecked="CheckBox_Toggled"/>

                    <!-- Task Title with strikethrough when completed -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Delete Button -->
                    <Button Grid.Column="2"
                            Content="Delete"
                            Background="DeepPink"
                            Width="60"
                            Command="{Binding DataContext.DeleteTaskCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>

            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Tasks"
                   FontSize="22"
                   FontFamily="Segoe UI Semibold"
                   Foreground="White"
                   Margin="0 0 0 10"/>

        <!-- FILTER BUTTONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 0 0 10">

            <Button Content="Today"
                    Width="80"
                    Background="Indigo"
                    Command="{Binding ShowTodayCommand}" />

            <Button Content="Done"
                    Width="80"
                    Background="LightSeaGreen"
                    Command="{Binding ShowCompletedCommand}" />

            <Button Content="Todo"
                    Width="80"
                    Background="OrangeRed"
                    Command="{Binding ShowUncompletedCommand}" />
        </StackPanel>

        <!-- TASK LIST -->
        <Border Grid.Row="2"
                Background="#323232"
                CornerRadius="8"
                Padding="10">

            <ListBox Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     ItemsSource="{Binding Tasks}"
                     ItemTemplate="{StaticResource TaskTemplate}"/>
        </Border>

        <!-- INPUT AREA -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="5 10 5 5"
                    HorizontalAlignment="Center">

            <TextBox Width="180"
                     Height="34"
                     FontSize="14"
                     Background="#444"
                     Foreground="White"
                     Padding="6"
                     BorderBrush="#666"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}">

                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>

            </TextBox>

            <Button Content="Add"
                    Width="60"
                    Background="Green"
                    Command="{Binding AddTaskCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>